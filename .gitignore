# ============================================
# COBOL Banking System - Git Ignore
# ============================================

# ============================================
# COMPILATION OUTPUT
# ============================================
# Executables generated by GnuCOBOL
*.exe
*.EXE

# Executables without extension (Linux/Mac)
# These patterns match files in root and subdirectories
/BANKPROC
/READMOV
/SEARCHACC
/UPDSALDO
/WRIHIST
/WRITERR
/READACC
/HELLO
/EXAMPLE-1
/EXAMPLE-2
/TEST-COMMON

# Object files
*.o
*.obj

# Generated C files (if using -C flag)
*.c
*.h

# ============================================
# RUNTIME OUTPUT FILES
# ============================================
# These are generated when running the batch program
output/ERRORS.DAT
output/HISTORICO.DAT
output/REPORT.DAT
output/AUDIT.DAT

# ============================================
# BACKUP AND TEMPORARY FILES
# ============================================
# Backup files
*.bak
*.BAK
*.backup
*.antes
*.antes.*
*.copy
*.old

# Temporary files
*.tmp
*.temp
*~
*.swp
*.swo

# Editor backup files
*.orig
*.rej

# ============================================
# LOG FILES
# ============================================
*.log
Compilaciones.txt

# ============================================
# OS-SPECIFIC FILES
# ============================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
._*

# Linux
*~
.directory
*.directory

# ============================================
# IDE AND EDITOR FILES
# ============================================
# VS Code
.vscode/
*.code-workspace

# Visual Studio
.vs/
*.suo
*.user

# Notepad++
nppBackup/

# Sublime Text
*.sublime-project
*.sublime-workspace

# ============================================
# TESTING AND DEBUGGING
# ============================================
# Test output (keep test cases, ignore generated results)
tests/output/
tests/temp/

# Debug files
*.dbg
*.dump

# ============================================
# DATA FILES (OPTIONAL)
# ============================================
# Uncomment if you want to ignore data files
# (not recommended for this project since data/ contains test data)
# data/*.DAT
# data/*.dat

# ============================================
# DOCUMENTATION TEMPORARY FILES
# ============================================
docs/drafts/
docs/temp/
*.draft

# ============================================
# ARCHIVES AND COMPRESSED FILES
# ============================================
*.zip
*.rar
*.7z
*.tar.gz
