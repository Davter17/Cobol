IDENTIFICATION DIVISION.
PROGRAM-ID. READMOV.
AUTHOR. MARIO PICO.
DATE-WRITTEN. 2026-03-01.

*>================================================*
*> Programa que lee MOVIMIENTOS.DAT y muestra     *
*> los datos de cada transaccion                  *
*>================================================*

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT MOVEMENTS-FILE ASSIGN TO 'data/MOVIMIENTOS.DAT'
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FILE-STATUS.

DATA DIVISION.
FILE SECTION.
FD MOVEMENTS-FILE.
01 WS-MOVEMENT-RECORD.
    05 WS-TRANSACTION-ID         PIC 9(10).
    05 WS-TRANSACTION-TYPE       PIC X(1).
    05 WS-TRANSACTION-ORIGIN     PIC 9(6).
    05 WS-TRANSACTION-DESTINATION PIC 9(6).
    05 WS-TRANSACTION-AMOUNT     PIC S9(10)V99.
    05 WS-TRANSACTION-DATE       PIC 9(8).
    05 WS-TRANSACTION-TIME       PIC 9(6).
    05 WS-TRANSACTION-CONCEPT    PIC X(40).

WORKING-STORAGE SECTION.
01 WS-FILE-STATUS          PIC XX.
01 WS-EOF-FLAG             PIC 9 VALUE 0.
    88 WS-EOF              VALUE 1.
01 WS-MOVEMENT-COUNT       PIC 9(4) VALUE 0.
01 WS-DISPLAY-AMOUNT       PIC ZZZ,ZZZ,ZZ9.99.
01 WS-TYPE-DESCRIPTION     PIC X(15).

01 WS-COUNTERS.
    05 WS-TRANSFER-COUNT   PIC 9(4) VALUE 0.
    05 WS-INGRESO-COUNT    PIC 9(4) VALUE 0.
    05 WS-RETIRADA-COUNT   PIC 9(4) VALUE 0.
    05 WS-PAGO-COUNT       PIC 9(4) VALUE 0.

01 WS-ACCUMULATORS.
    05 WS-TRANSFER-TOTAL   PIC S9(12)V99 VALUE 0.
    05 WS-INGRESO-TOTAL    PIC S9(12)V99 VALUE 0.
    05 WS-RETIRADA-TOTAL   PIC S9(12)V99 VALUE 0.
    05 WS-PAGO-TOTAL       PIC S9(12)V99 VALUE 0.
    05 WS-GRAND-TOTAL      PIC S9(12)V99 VALUE 0.

01 WS-DISPLAY-TOTAL        PIC ZZZ,ZZZ,ZZ9.99.

PROCEDURE DIVISION.
MAIN-PROGRAM.
    PERFORM OPEN-FILES
    PERFORM READ-MOVEMENTS
    PERFORM CLOSE-FILES
    PERFORM SHOW-SUMMARY
    STOP RUN.

OPEN-FILES.
    OPEN INPUT MOVEMENTS-FILE
    IF WS-FILE-STATUS NOT = "00"
        DISPLAY "ERROR OPENING FILE: " WS-FILE-STATUS
        STOP RUN
    END-IF.

READ-MOVEMENTS.
    DISPLAY "========================================"
    DISPLAY "      LISTADO DE MOVIMIENTOS"
    DISPLAY "========================================"
    DISPLAY " "
    DISPLAY "ID        TIPO  ORIGEN DESTINO     IMPORTE       FECHA      CONCEPTO"
    DISPLAY "--------  ----  ------ ------  ------------  --------  ----------------"
    
    PERFORM UNTIL WS-EOF
        READ MOVEMENTS-FILE
            AT END
                SET WS-EOF TO TRUE
            NOT AT END
                ADD 1 TO WS-MOVEMENT-COUNT
                PERFORM DISPLAY-MOVEMENT
        END-READ
    END-PERFORM.

DISPLAY-MOVEMENT.
    MOVE WS-TRANSACTION-AMOUNT TO WS-DISPLAY-AMOUNT
    PERFORM GET-TYPE-DESCRIPTION
    PERFORM UPDATE-COUNTERS
    DISPLAY WS-TRANSACTION-ID "  "
            WS-TYPE-DESCRIPTION "  "
            WS-TRANSACTION-ORIGIN "  "
            WS-TRANSACTION-DESTINATION "  "
            WS-DISPLAY-AMOUNT "  "
            WS-TRANSACTION-DATE "  "
            WS-TRANSACTION-CONCEPT.

UPDATE-COUNTERS.
    EVALUATE WS-TRANSACTION-TYPE
        WHEN "T"
            ADD 1 TO WS-TRANSFER-COUNT
            ADD WS-TRANSACTION-AMOUNT TO WS-TRANSFER-TOTAL
        WHEN "I"
            ADD 1 TO WS-INGRESO-COUNT
            ADD WS-TRANSACTION-AMOUNT TO WS-INGRESO-TOTAL
        WHEN "R"
            ADD 1 TO WS-RETIRADA-COUNT
            ADD WS-TRANSACTION-AMOUNT TO WS-RETIRADA-TOTAL
        WHEN "P"
            ADD 1 TO WS-PAGO-COUNT
            ADD WS-TRANSACTION-AMOUNT TO WS-PAGO-TOTAL
    END-EVALUATE
    ADD WS-TRANSACTION-AMOUNT TO WS-GRAND-TOTAL.

GET-TYPE-DESCRIPTION.
    EVALUATE WS-TRANSACTION-TYPE
        WHEN "T"
            MOVE "TRANSFERENCIA" TO WS-TYPE-DESCRIPTION
        WHEN "I"
            MOVE "INGRESO" TO WS-TYPE-DESCRIPTION
        WHEN "R"
            MOVE "RETIRADA" TO WS-TYPE-DESCRIPTION
        WHEN "P"
            MOVE "PAGO" TO WS-TYPE-DESCRIPTION
        WHEN OTHER
            MOVE "DESCONOCIDO" TO WS-TYPE-DESCRIPTION
    END-EVALUATE.

CLOSE-FILES.
    CLOSE MOVEMENTS-FILE.

SHOW-SUMMARY.
    DISPLAY " "
    DISPLAY "========================================"
    DISPLAY "          RESUMEN DE MOVIMIENTOS"
    DISPLAY "========================================"
    DISPLAY " "
    DISPLAY "TOTAL DE MOVIMIENTOS: " WS-MOVEMENT-COUNT
    DISPLAY " "
    DISPLAY "POR TIPO DE OPERACION:"
    DISPLAY "----------------------"
    DISPLAY "TRANSFERENCIAS: " WS-TRANSFER-COUNT
    MOVE WS-TRANSFER-TOTAL TO WS-DISPLAY-TOTAL
    DISPLAY "  IMPORTE TOTAL: " WS-DISPLAY-TOTAL " EUR"
    DISPLAY " "
    DISPLAY "INGRESOS:       " WS-INGRESO-COUNT
    MOVE WS-INGRESO-TOTAL TO WS-DISPLAY-TOTAL
    DISPLAY "  IMPORTE TOTAL: " WS-DISPLAY-TOTAL " EUR"
    DISPLAY " "
    DISPLAY "RETIRADAS:      " WS-RETIRADA-COUNT
    MOVE WS-RETIRADA-TOTAL TO WS-DISPLAY-TOTAL
    DISPLAY "  IMPORTE TOTAL: " WS-DISPLAY-TOTAL " EUR"
    DISPLAY " "
    DISPLAY "PAGOS:          " WS-PAGO-COUNT
    MOVE WS-PAGO-TOTAL TO WS-DISPLAY-TOTAL
    DISPLAY "  IMPORTE TOTAL: " WS-DISPLAY-TOTAL " EUR"
    DISPLAY " "
    DISPLAY "========================================"
    MOVE WS-GRAND-TOTAL TO WS-DISPLAY-TOTAL
    DISPLAY "IMPORTE TOTAL PROCESADO: " WS-DISPLAY-TOTAL " EUR"
    DISPLAY "========================================".
