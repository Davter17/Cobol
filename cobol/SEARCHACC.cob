IDENTIFICATION DIVISION.
PROGRAM-ID. SEARCHACC.
AUTHOR. MARIO PICO.
DATE-WRITTEN. 2026-03-01.

*>================================================*
*> Programa que busca una cuenta por numero       *
*> en CUENTAS.DAT y muestra sus datos             *
*>================================================*

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ACCOUNTS-FILE ASSIGN TO 'data/CUENTAS.DAT'
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FILE-STATUS.

DATA DIVISION.
FILE SECTION.
FD ACCOUNTS-FILE.
01 WS-ACCOUNT-RECORD.
    05 WS-ACCOUNT-NUMBER       PIC 9(6).
    05 WS-ACCOUNT-DNI          PIC X(9).
    05 WS-ACCOUNT-NAME         PIC X(30).
    05 WS-ACCOUNT-BALANCE      PIC S9(10)V99.
    05 WS-ACCOUNT-STATUS       PIC X(1).
    05 WS-ACCOUNT-OPEN-DATE    PIC 9(8).
    05 WS-ACCOUNT-DAILY-LIMIT  PIC 9(10)V99.

WORKING-STORAGE SECTION.
01 WS-FILE-STATUS          PIC XX.
01 WS-EOF-FLAG             PIC 9 VALUE 0.
    88 WS-EOF              VALUE 1.
01 WS-FOUND-FLAG           PIC 9 VALUE 0.
    88 WS-FOUND            VALUE 1.
01 WS-VALID-FLAG           PIC 9 VALUE 0.
    88 WS-VALID            VALUE 1.
01 WS-SEARCH-ACCOUNT       PIC 9(6).
01 WS-VALIDATE-AMOUNT      PIC S9(10)V99.
01 WS-DISPLAY-AMOUNT       PIC ZZZ,ZZZ,ZZ9.99.
01 WS-DISPLAY-BALANCE      PIC ZZZ,ZZZ,ZZ9.99.
01 WS-DISPLAY-LIMIT        PIC ZZZ,ZZZ,ZZ9.99.
01 WS-STATUS-DESCRIPTION   PIC X(12).
01 WS-ERROR-CODE           PIC X(4).
01 WS-ERROR-DESCRIPTION    PIC X(30).

01 WS-FOUND-RECORD.
    05 WS-FOUND-NUMBER       PIC 9(6).
    05 WS-FOUND-DNI          PIC X(9).
    05 WS-FOUND-NAME         PIC X(30).
    05 WS-FOUND-BALANCE      PIC S9(10)V99.
    05 WS-FOUND-STATUS       PIC X(1).
    05 WS-FOUND-OPEN-DATE    PIC 9(8).
    05 WS-FOUND-DAILY-LIMIT  PIC 9(10)V99.

PROCEDURE DIVISION.
MAIN-PROGRAM.
    PERFORM INITIALIZE-PROGRAM
    PERFORM OPEN-FILES
    PERFORM SEARCH-ACCOUNT
    PERFORM CLOSE-FILES
    PERFORM VALIDATE-ACCOUNT
    PERFORM SHOW-RESULT
    STOP RUN.

INITIALIZE-PROGRAM.
    DISPLAY "========================================"
    DISPLAY "      VALIDACION DE CUENTA"
    DISPLAY "========================================"
    DISPLAY " "
    DISPLAY "NUMERO DE CUENTA:"
    ACCEPT WS-SEARCH-ACCOUNT FROM CONSOLE
    DISPLAY "IMPORTE A VALIDAR:"
    ACCEPT WS-VALIDATE-AMOUNT FROM CONSOLE
    DISPLAY " ".

OPEN-FILES.
    OPEN INPUT ACCOUNTS-FILE
    IF WS-FILE-STATUS NOT = "00"
        DISPLAY "ERROR OPENING FILE: " WS-FILE-STATUS
        STOP RUN
    END-IF.

SEARCH-ACCOUNT.
    PERFORM UNTIL WS-EOF
        READ ACCOUNTS-FILE
            AT END
                SET WS-EOF TO TRUE
            NOT AT END
                IF WS-ACCOUNT-NUMBER = WS-SEARCH-ACCOUNT
                    SET WS-FOUND TO TRUE
                    MOVE WS-ACCOUNT-RECORD TO WS-FOUND-RECORD
                    SET WS-EOF TO TRUE
                END-IF
        END-READ
    END-PERFORM.

CLOSE-FILES.
    CLOSE ACCOUNTS-FILE.

VALIDATE-ACCOUNT.
    IF WS-FOUND
        EVALUATE WS-FOUND-STATUS
            WHEN "A"
                IF WS-FOUND-BALANCE >= WS-VALIDATE-AMOUNT
                    SET WS-VALID TO TRUE
                    MOVE "OK" TO WS-ERROR-CODE
                    MOVE "SALDO SUFICIENTE" TO WS-ERROR-DESCRIPTION
                ELSE
                    MOVE "E002" TO WS-ERROR-CODE
                    MOVE "SALDO INSUFICIENTE" TO WS-ERROR-DESCRIPTION
                END-IF
            WHEN "B"
                MOVE "E003" TO WS-ERROR-CODE
                MOVE "CUENTA BLOQUEADA" TO WS-ERROR-DESCRIPTION
            WHEN "I"
                MOVE "E006" TO WS-ERROR-CODE
                MOVE "CUENTA INACTIVA" TO WS-ERROR-DESCRIPTION
            WHEN OTHER
                MOVE "E010" TO WS-ERROR-CODE
                MOVE "ESTADO DESCONOCIDO" TO WS-ERROR-DESCRIPTION
        END-EVALUATE
    ELSE
        MOVE "E001" TO WS-ERROR-CODE
        MOVE "CUENTA INEXISTENTE" TO WS-ERROR-DESCRIPTION
    END-IF.

SHOW-RESULT.
    DISPLAY "========================================"
    DISPLAY "       VALIDACION DE CUENTA"
    DISPLAY "========================================"
    DISPLAY " "
    DISPLAY "CUENTA BUSCADA: " WS-SEARCH-ACCOUNT
    MOVE WS-VALIDATE-AMOUNT TO WS-DISPLAY-AMOUNT
    DISPLAY "IMPORTE:        " WS-DISPLAY-AMOUNT " EUR"
    DISPLAY " "
    IF WS-FOUND
        DISPLAY "RESULTADO BUSQUEDA: ENCONTRADA"
        DISPLAY " "
        DISPLAY "DATOS DE LA CUENTA:"
        DISPLAY "-------------------"
        DISPLAY "NUMERO:      " WS-FOUND-NUMBER
        DISPLAY "DNI/NIF:     " WS-FOUND-DNI
        DISPLAY "TITULAR:     " WS-FOUND-NAME
        MOVE WS-FOUND-BALANCE TO WS-DISPLAY-BALANCE
        DISPLAY "SALDO:       " WS-DISPLAY-BALANCE " EUR"
        PERFORM GET-STATUS-DESCRIPTION
        DISPLAY "ESTADO:      " WS-STATUS-DESCRIPTION
        DISPLAY "FECHA ALTA:  " WS-FOUND-OPEN-DATE
        MOVE WS-FOUND-DAILY-LIMIT TO WS-DISPLAY-LIMIT
        DISPLAY "LIMITE DIARIO: " WS-DISPLAY-LIMIT " EUR"
        DISPLAY " "
        DISPLAY "VALIDACION:"
        DISPLAY "-----------"
        DISPLAY "CODIGO: " WS-ERROR-CODE
        DISPLAY "ESTADO: " WS-ERROR-DESCRIPTION
        DISPLAY " "
        IF WS-VALID
            DISPLAY ">>> OPERACION PERMITIDA <<<"
        ELSE
            DISPLAY ">>> OPERACION NO PERMITIDA <<<"
        END-IF
    ELSE
        DISPLAY "RESULTADO BUSQUEDA: NO ENCONTRADA"
        DISPLAY " "
        DISPLAY "VALIDACION:"
        DISPLAY "-----------"
        DISPLAY "CODIGO: " WS-ERROR-CODE
        DISPLAY "ESTADO: " WS-ERROR-DESCRIPTION
        DISPLAY " "
        DISPLAY ">>> OPERACION NO PERMITIDA <<<"
    END-IF
    DISPLAY "========================================".

GET-STATUS-DESCRIPTION.
    EVALUATE WS-FOUND-STATUS
        WHEN "A"
            MOVE "ACTIVA" TO WS-STATUS-DESCRIPTION
        WHEN "B"
            MOVE "BLOQUEADA" TO WS-STATUS-DESCRIPTION
        WHEN "I"
            MOVE "INACTIVA" TO WS-STATUS-DESCRIPTION
        WHEN OTHER
            MOVE "DESCONOCIDO" TO WS-STATUS-DESCRIPTION
    END-EVALUATE.
