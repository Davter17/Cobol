IDENTIFICATION DIVISION.
PROGRAM-ID. UPDSALDO.
AUTHOR. MARIO PICO.
DATE-WRITTEN. 2026-03-01.

*>================================================*
*> Programa que actualiza el saldo de una cuenta  *
*> en CUENTAS.DAT usando OPEN I-O y REWRITE       *
*>================================================*

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ACCOUNTS-FILE ASSIGN TO 'data/CUENTAS.DAT'
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FILE-STATUS.

DATA DIVISION.
FILE SECTION.
FD ACCOUNTS-FILE.
01 WS-ACCOUNT-RECORD.
    05 WS-ACCOUNT-NUMBER       PIC 9(6).
    05 WS-ACCOUNT-DNI          PIC X(9).
    05 WS-ACCOUNT-NAME         PIC X(30).
    05 WS-ACCOUNT-BALANCE      PIC S9(10)V99.
    05 WS-ACCOUNT-STATUS       PIC X(1).
    05 WS-ACCOUNT-OPEN-DATE    PIC 9(8).
    05 WS-ACCOUNT-DAILY-LIMIT  PIC 9(10)V99.

WORKING-STORAGE SECTION.
01 WS-FILE-STATUS          PIC XX.
01 WS-EOF-FLAG             PIC 9 VALUE 0.
    88 WS-EOF              VALUE 1.
01 WS-FOUND-FLAG           PIC 9 VALUE 0.
    88 WS-FOUND            VALUE 1.
01 WS-SEARCH-ACCOUNT       PIC 9(6).
01 WS-OPERATION-TYPE       PIC X.
    88 WS-DEBIT            VALUE "D".
    88 WS-CREDIT           VALUE "C".
01 WS-OPERATION-AMOUNT     PIC S9(10)V99.
01 WS-DISPLAY-BALANCE      PIC ZZZ,ZZZ,ZZ9.99.
01 WS-DISPLAY-AMOUNT       PIC ZZZ,ZZZ,ZZ9.99.
01 WS-NEW-BALANCE          PIC S9(10)V99.

PROCEDURE DIVISION.
MAIN-PROGRAM.
    PERFORM INITIALIZE-PROGRAM
    PERFORM OPEN-FILES
    PERFORM SEARCH-AND-UPDATE
    PERFORM CLOSE-FILES
    PERFORM SHOW-RESULT
    STOP RUN.

INITIALIZE-PROGRAM.
    DISPLAY "========================================"
    DISPLAY "      ACTUALIZACION DE SALDO"
    DISPLAY "========================================"
    DISPLAY " "
    DISPLAY "NUMERO DE CUENTA:"
    ACCEPT WS-SEARCH-ACCOUNT FROM CONSOLE
    DISPLAY "OPERACION (D=DEBITO, C=CREDITO):"
    ACCEPT WS-OPERATION-TYPE FROM CONSOLE
    DISPLAY "IMPORTE:"
    ACCEPT WS-OPERATION-AMOUNT FROM CONSOLE
    DISPLAY " ".

OPEN-FILES.
    OPEN I-O ACCOUNTS-FILE
    IF WS-FILE-STATUS NOT = "00"
        DISPLAY "ERROR OPENING FILE: " WS-FILE-STATUS
        STOP RUN
    END-IF.

SEARCH-AND-UPDATE.
    PERFORM UNTIL WS-EOF
        READ ACCOUNTS-FILE
            AT END
                SET WS-EOF TO TRUE
            NOT AT END
                IF WS-ACCOUNT-NUMBER = WS-SEARCH-ACCOUNT
                    SET WS-FOUND TO TRUE
                    MOVE WS-ACCOUNT-BALANCE TO WS-DISPLAY-BALANCE
                    DISPLAY "SALDO ANTERIOR: " WS-DISPLAY-BALANCE " EUR"
                    EVALUATE TRUE
                        WHEN WS-CREDIT
                            ADD WS-OPERATION-AMOUNT TO WS-ACCOUNT-BALANCE
                        WHEN WS-DEBIT
                            SUBTRACT WS-OPERATION-AMOUNT FROM WS-ACCOUNT-BALANCE
                    END-EVALUATE
                    MOVE WS-ACCOUNT-BALANCE TO WS-NEW-BALANCE
                    REWRITE WS-ACCOUNT-RECORD
                    SET WS-EOF TO TRUE
                END-IF
        END-READ
    END-PERFORM.

CLOSE-FILES.
    CLOSE ACCOUNTS-FILE.

SHOW-RESULT.
    DISPLAY " "
    DISPLAY "========================================"
    IF WS-FOUND
        DISPLAY "RESULTADO: OPERACION COMPLETADA"
        DISPLAY "========================================"
        DISPLAY " "
        DISPLAY "CUENTA:    " WS-SEARCH-ACCOUNT
        DISPLAY "TITULAR:   " WS-ACCOUNT-NAME
        IF WS-CREDIT
            DISPLAY "OPERACION: CREDITO"
        ELSE
            DISPLAY "OPERACION: DEBITO"
        END-IF
        MOVE WS-OPERATION-AMOUNT TO WS-DISPLAY-AMOUNT
        DISPLAY "IMPORTE:   " WS-DISPLAY-AMOUNT " EUR"
        MOVE WS-NEW-BALANCE TO WS-DISPLAY-BALANCE
        DISPLAY "SALDO NUEVO: " WS-DISPLAY-BALANCE " EUR"
    ELSE
        DISPLAY "RESULTADO: CUENTA NO ENCONTRADA"
        DISPLAY "========================================"
    END-IF.
