IDENTIFICATION DIVISION.
PROGRAM-ID. WRIHIST.
AUTHOR. MARIO PICO.
DATE-WRITTEN. 2026-03-01.

*>================================================*
*> Programa que registra operaciones en           *
*> HISTORICO.DAT usando OPEN EXTEND               *
*>================================================*

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT HISTORIC-FILE ASSIGN TO 'output/HISTORICO.DAT'
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FILE-STATUS.

DATA DIVISION.
FILE SECTION.
FD HISTORIC-FILE.
01 WS-HISTORIC-RECORD.
    05 WS-HIST-TIMESTAMP         PIC X(26).
    05 WS-HIST-TRANSACTION-ID    PIC 9(10).
    05 WS-HIST-TRANSACTION-TYPE  PIC X(1).
    05 WS-HIST-ORIGIN-ACCOUNT    PIC 9(6).
    05 WS-HIST-DESTINATION-ACCOUNT PIC 9(6).
    05 WS-HIST-AMOUNT            PIC S9(10)V99.
    05 WS-HIST-DATE              PIC 9(8).
    05 WS-HIST-TIME              PIC 9(6).
    05 WS-HIST-CONCEPT           PIC X(40).

WORKING-STORAGE SECTION.
01 WS-FILE-STATUS          PIC XX.
01 WS-TRANSACTION-TYPE     PIC X(1).
01 WS-TRANSACTION-AMOUNT   PIC S9(10)V99.
01 WS-DISPLAY-AMOUNT       PIC ZZZ,ZZZ,ZZ9.99.

PROCEDURE DIVISION.
MAIN-PROGRAM.
    PERFORM INITIALIZE-PROGRAM
    PERFORM OPEN-FILES
    PERFORM WRITE-HISTORIC
    PERFORM CLOSE-FILES
    PERFORM SHOW-SUMMARY
    STOP RUN.

INITIALIZE-PROGRAM.
    DISPLAY "========================================"
    DISPLAY "      REGISTRO EN HISTORICO"
    DISPLAY "========================================"
    DISPLAY " "
    DISPLAY "TIMESTAMP:"
    ACCEPT WS-HIST-TIMESTAMP FROM CONSOLE
    DISPLAY "ID TRANSACCION:"
    ACCEPT WS-HIST-TRANSACTION-ID FROM CONSOLE
    DISPLAY "TIPO (T/I/R/P):"
    ACCEPT WS-TRANSACTION-TYPE FROM CONSOLE
    MOVE WS-TRANSACTION-TYPE TO WS-HIST-TRANSACTION-TYPE
    DISPLAY "CUENTA ORIGEN:"
    ACCEPT WS-HIST-ORIGIN-ACCOUNT FROM CONSOLE
    DISPLAY "CUENTA DESTINO:"
    ACCEPT WS-HIST-DESTINATION-ACCOUNT FROM CONSOLE
    DISPLAY "IMPORTE:"
    ACCEPT WS-TRANSACTION-AMOUNT FROM CONSOLE
    MOVE WS-TRANSACTION-AMOUNT TO WS-HIST-AMOUNT
    DISPLAY "FECHA (YYYYMMDD):"
    ACCEPT WS-HIST-DATE FROM CONSOLE
    DISPLAY "HORA (HHMMSS):"
    ACCEPT WS-HIST-TIME FROM CONSOLE
    DISPLAY "CONCEPTO:"
    ACCEPT WS-HIST-CONCEPT FROM CONSOLE
    DISPLAY " ".

OPEN-FILES.
    OPEN EXTEND HISTORIC-FILE
    IF WS-FILE-STATUS = "35"
        OPEN OUTPUT HISTORIC-FILE
        IF WS-FILE-STATUS NOT = "00"
            DISPLAY "ERROR CREATING FILE: " WS-FILE-STATUS
            STOP RUN
        END-IF
    ELSE IF WS-FILE-STATUS NOT = "00"
        DISPLAY "ERROR OPENING FILE: " WS-FILE-STATUS
        STOP RUN
    END-IF.

WRITE-HISTORIC.
    WRITE WS-HISTORIC-RECORD
    IF WS-FILE-STATUS NOT = "00"
        DISPLAY "ERROR WRITING RECORD: " WS-FILE-STATUS
    END-IF.

CLOSE-FILES.
    CLOSE HISTORIC-FILE.

SHOW-SUMMARY.
    DISPLAY "========================================"
    DISPLAY "      REGISTRO COMPLETADO"
    DISPLAY "========================================"
    DISPLAY " "
    DISPLAY "ID TRANSACCION: " WS-HIST-TRANSACTION-ID
    DISPLAY "TIPO:           " WS-HIST-TRANSACTION-TYPE
    DISPLAY "ORIGEN:         " WS-HIST-ORIGIN-ACCOUNT
    DISPLAY "DESTINO:        " WS-HIST-DESTINATION-ACCOUNT
    MOVE WS-HIST-AMOUNT TO WS-DISPLAY-AMOUNT
    DISPLAY "IMPORTE:        " WS-DISPLAY-AMOUNT " EUR"
    DISPLAY "FECHA:          " WS-HIST-DATE
    DISPLAY "CONCEPTO:       " WS-HIST-CONCEPT
    DISPLAY " "
    DISPLAY "FICHERO: output/HISTORICO.DAT"
    DISPLAY "========================================".
