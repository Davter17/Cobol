IDENTIFICATION DIVISION.
PROGRAM-ID. WRITERR.
AUTHOR. MARIO PICO.
DATE-WRITTEN. 2026-03-01.

*>================================================*
*> Programa que escribe registros de error        *
*> de prueba en ERRORS.DAT                        *
*>================================================*

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT ERRORS-FILE ASSIGN TO 'output/ERRORS.DAT'
        ORGANIZATION IS LINE SEQUENTIAL
        FILE STATUS IS WS-FILE-STATUS.

DATA DIVISION.
FILE SECTION.
FD ERRORS-FILE.
01 WS-ERROR-RECORD.
    05 WS-ERR-TIMESTAMP          PIC X(26).
    05 WS-ERR-TRANSACTION-ID     PIC 9(10).
    05 WS-ERR-CODE               PIC X(4).
    05 WS-ERR-DESCRIPTION        PIC X(50).
    05 WS-ERR-ACCOUNT-ID         PIC 9(6).
    05 WS-ERR-AMOUNT             PIC S9(10)V99.

WORKING-STORAGE SECTION.
01 WS-FILE-STATUS          PIC XX.
01 WS-RECORD-COUNT         PIC 9(2) VALUE 0.

PROCEDURE DIVISION.
MAIN-PROGRAM.
    PERFORM OPEN-FILES
    PERFORM WRITE-ERRORS
    PERFORM CLOSE-FILES
    PERFORM SHOW-SUMMARY
    STOP RUN.

OPEN-FILES.
    OPEN OUTPUT ERRORS-FILE
    IF WS-FILE-STATUS NOT = "00"
        DISPLAY "ERROR OPENING FILE: " WS-FILE-STATUS
        STOP RUN
    END-IF.

WRITE-ERRORS.
    PERFORM WRITE-ERROR-1
    PERFORM WRITE-ERROR-2
    PERFORM WRITE-ERROR-3
    PERFORM WRITE-ERROR-4
    PERFORM WRITE-ERROR-5.

WRITE-ERROR-1.
    MOVE "2026-03-01-02.15.30.123456" TO WS-ERR-TIMESTAMP
    MOVE 0000000041 TO WS-ERR-TRANSACTION-ID
    MOVE "E001" TO WS-ERR-CODE
    MOVE "CUENTA INEXISTENTE" TO WS-ERR-DESCRIPTION
    MOVE 999999 TO WS-ERR-ACCOUNT-ID
    MOVE 100.00 TO WS-ERR-AMOUNT
    WRITE WS-ERROR-RECORD
    ADD 1 TO WS-RECORD-COUNT.

WRITE-ERROR-2.
    MOVE "2026-03-01-02.15.31.234567" TO WS-ERR-TIMESTAMP
    MOVE 0000000046 TO WS-ERR-TRANSACTION-ID
    MOVE "E002" TO WS-ERR-CODE
    MOVE "SALDO INSUFICIENTE" TO WS-ERR-DESCRIPTION
    MOVE 000004 TO WS-ERR-ACCOUNT-ID
    MOVE 5000.00 TO WS-ERR-AMOUNT
    WRITE WS-ERROR-RECORD
    ADD 1 TO WS-RECORD-COUNT.

WRITE-ERROR-3.
    MOVE "2026-03-01-02.15.32.345678" TO WS-ERR-TIMESTAMP
    MOVE 0000000051 TO WS-ERR-TRANSACTION-ID
    MOVE "E003" TO WS-ERR-CODE
    MOVE "CUENTA BLOQUEADA" TO WS-ERR-DESCRIPTION
    MOVE 000007 TO WS-ERR-ACCOUNT-ID
    MOVE 100.00 TO WS-ERR-AMOUNT
    WRITE WS-ERROR-RECORD
    ADD 1 TO WS-RECORD-COUNT.

WRITE-ERROR-4.
    MOVE "2026-03-01-02.15.33.456789" TO WS-ERR-TIMESTAMP
    MOVE 0000000054 TO WS-ERR-TRANSACTION-ID
    MOVE "E004" TO WS-ERR-CODE
    MOVE "IMPORTE INVALIDO" TO WS-ERR-DESCRIPTION
    MOVE 000001 TO WS-ERR-ACCOUNT-ID
    MOVE 0.00 TO WS-ERR-AMOUNT
    WRITE WS-ERROR-RECORD
    ADD 1 TO WS-RECORD-COUNT.

WRITE-ERROR-5.
    MOVE "2026-03-01-02.15.34.567890" TO WS-ERR-TIMESTAMP
    MOVE 0000000001 TO WS-ERR-TRANSACTION-ID
    MOVE "E005" TO WS-ERR-CODE
    MOVE "MOVIMIENTO DUPLICADO" TO WS-ERR-DESCRIPTION
    MOVE 000001 TO WS-ERR-ACCOUNT-ID
    MOVE 500.00 TO WS-ERR-AMOUNT
    WRITE WS-ERROR-RECORD
    ADD 1 TO WS-RECORD-COUNT.

CLOSE-FILES.
    CLOSE ERRORS-FILE.

SHOW-SUMMARY.
    DISPLAY "========================================"
    DISPLAY "      ESCRITURA DE ERRORES"
    DISPLAY "========================================"
    DISPLAY " "
    DISPLAY "FICHERO: output/ERRORS.DAT"
    DISPLAY "REGISTROS ESCRITOS: " WS-RECORD-COUNT
    DISPLAY " "
    DISPLAY "ERRORES GENERADOS:"
    DISPLAY "  - E001: CUENTA INEXISTENTE"
    DISPLAY "  - E002: SALDO INSUFICIENTE"
    DISPLAY "  - E003: CUENTA BLOQUEADA"
    DISPLAY "  - E004: IMPORTE INVALIDO"
    DISPLAY "  - E005: MOVIMIENTO DUPLICADO"
    DISPLAY " "
    DISPLAY "========================================".
