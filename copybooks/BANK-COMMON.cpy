*>================================================*
*> BANK-COMMON.cpy                                *
*> Constantes globales del sistema bancario       *
*>================================================*

*>--- IDENTIFICACION DEL BANCO
01 WS-BANK-CODE            PIC X(4)  VALUE "0001".
01 WS-BANK-NAME            PIC X(30) VALUE "COBOL BANKING SYSTEM".
01 WS-SYSTEM-VERSION       PIC 9(2)  VALUE 1.

*>--- ESTADOS DE CUENTA
01 WS-ACCOUNT-STATUS       PIC X(1).
    88 STATUS-ACTIVE       VALUE "A".
    88 STATUS-BLOCKED      VALUE "B".
    88 STATUS-INACTIVE     VALUE "I".

*>--- TIPOS DE OPERACION
01 WS-TRANSACTION-TYPE     PIC X(1).
    88 TYPE-TRANSFER       VALUE "T".
    88 TYPE-DEPOSIT        VALUE "I".
    88 TYPE-WITHDRAWAL     VALUE "R".
    88 TYPE-PAYMENT        VALUE "P".

*>--- LIMITES DE IMPORTE
01 WS-MIN-AMOUNT           PIC 9(10)V99 VALUE 0.01.
01 WS-MAX-AMOUNT           PIC 9(10)V99 VALUE 99999999.99.
01 WS-MAX-DAILY-LIMIT      PIC 9(10)V99 VALUE 50000.00.

*>--- COMISIONES
01 WS-COMM-TRANSFER-PCT    PIC 9V9999 VALUE 0.0010.
01 WS-COMM-TRANSFER-MIN    PIC 9(4)V99  VALUE 0.50.
01 WS-COMM-WITHDRAWAL-FIX  PIC 9(4)V99  VALUE 2.00.
01 WS-COMM-PAYMENT-PCT     PIC 9V9999 VALUE 0.0005.
01 WS-COMM-DEPOSIT-FIX     PIC 9(4)V99  VALUE 0.00.

*>--- LONGITUDES DE FICHEROS
01 WS-LEN-ACCOUNT-RECORD   PIC 9(4) VALUE 150.
01 WS-LEN-CLIENT-RECORD    PIC 9(4) VALUE 200.
01 WS-LEN-TRANSACTION-REC  PIC 9(4) VALUE 120.
01 WS-LEN-ERROR-RECORD     PIC 9(4) VALUE 100.

*>--- VALORES BOOLEANOS
01 WS-FLAG                 PIC X(1).
    88 FLAG-TRUE           VALUE "S".
    88 FLAG-FALSE          VALUE "N".

*>--- RESULTADO DE OPERACIONES
01 WS-OP-RESULT            PIC X(1).
    88 RESULT-OK           VALUE "K".
    88 RESULT-ERROR        VALUE "E".
